    },
    "Battery Level: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー残量: %@"
          }
        }
      }
    },
    "Buy the Developer a Coffee" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発者にコーヒーを送る"
          }
        }
      }
    },
    "Charging Battery: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーへの充電: %@"
          }
        }
      }
    },
    "Choose what appears in the menu bar. The icon changes automatically with the power state." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーに表示する内容を選べます。アイコンは電源の状態に応じて自動で変わります。"
          }
        }
      }
    },
    "Choose which items appear when you click the menu bar icon. Hover over an item for details." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーをクリックした際に表示される項目を選べます。各項目にマウスを合わせると詳しい説明が表示されます。"
          }
        }
      }
    },
    "Current battery charge level." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のバッテリー残量"
          }
        }
      }
    },
    "Current battery temperature. Staying hot for long periods can shorten battery life." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーの現在の温度です。高温が続くとバッテリーの寿命に影響する可能性があります。"
          }
        }
      }
    },
    "Current maximum capacity compared with the design capacity. The closer to 100 percent, the less the battery has worn." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設計容量に対する現在の最大容量の割合です。100％に近いほどバッテリーの劣化が少ないことを示します。"
          }
        }
      }
    },
    "Cycle Count" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイクル数"
          }
        }
      }
    },
    "Cycle Count: %lld" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイクル数: %lld回"
