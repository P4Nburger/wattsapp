        }
      }
    },
    "Number of charge cycles. Mac notebook batteries are designed to retain up to 80 percent of their original capacity at 1,000 cycles." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーの充放電サイクル回数です。Mac のノートブックのバッテリーは、1000 サイクルの時点で本来の容量の最大 80％ を保つよう設計されています。"
          }
        }
      }
    },
    "Power Draw: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消費電力: %@"
          }
        }
      }
    },
    "Quit WattsApp" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WattsApp を終了"
