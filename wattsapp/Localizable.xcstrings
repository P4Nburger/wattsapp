    "Settings…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定…"
          }
        }
      }
    },
    "Shows power usage in the macOS menu bar." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS のメニューバーに消費電力を表示"
          }
        }
      }
    },
    "Shows the current battery charge level as a percentage." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のバッテリー残量をパーセンテージで表示します。"
          }
        }
      }
    },
    "Shows the remaining battery time when on battery, and the estimated time to full while charging." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー駆動時は使用可能な残り時間、充電中は満充電までの予想時間を表示します。"
          }
        }
      }
    },
