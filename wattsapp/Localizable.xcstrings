        }
      }
    },
    "Estimated battery time remaining at the current power draw." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の消費電力に基づくバッテリーの残り使用時間"
