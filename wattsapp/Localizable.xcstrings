    "About" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "情報"
          }
        }
      }
    },
    "Adapter Input: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプタからの入力: %@"
          }
        }
      }
    },
    "Adjusts the interval to the power state: every 2 seconds while charging, 3 seconds on battery, and 5 seconds when plugged in but not charging." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源の状態に応じて自動で間隔を調整します。充電中は2秒、バッテリー駆動中は3秒、AC接続（非充電）時は5秒で更新します。"
          }
        }
      }
    },
    "Battery Assist: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーからの補助: %@"
          }
        }
      }
    },
    "Battery Health" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー健康度"
          }
        }
      }
    },
    "Battery Health: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー健康度: %@"
          }
        }
      }
    },
    "Battery Level" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー残量"
          }
        }
