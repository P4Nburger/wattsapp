            "value" : "更新間隔"
          }
        }
      }
    },
    "Updates about every 1.5 seconds. Handy for following changes in real time, but uses slightly more battery." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約1.5秒ごとに更新します。リアルタイムで変化を追いたい時に便利ですが、バッテリー消費がやや増えます。"
          }
        }
      }
    },
    "Updates every 5 seconds. Recommended if you want to save battery." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5秒ごとに更新します。バッテリー消費を抑えたい場合におすすめです。"
          }
        }
      }
