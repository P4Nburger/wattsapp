      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ再起動"
          }
        }
      }
    },
    "Restart WattsApp to apply the new language." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語の変更は WattsApp の再起動後に反映されます。"
