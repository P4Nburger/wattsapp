  "strings" : {
    "%@ / Adapter: %lldW" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / アダプタ: %2$lldW"
          }
        }
      }
    },
